{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 12:00 and before 22:00"
  ],
  "prConcurrentLimit": 50,
  "prHourlyLimit": 50,
  "commitMessagePrefix": "chore:",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "assignees": [],
  "reviewers": [],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Auto-merge patch and minor updates for Helm charts",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Auto-merge patch and minor updates for Docker images",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Auto-merge patch and minor updates for Python packages",
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Auto-merge patch and minor updates for JavaScript/Node.js packages",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Auto-merge patch and minor updates for Go modules",
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Auto-merge patch and minor updates for GitHub Actions",
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Auto-merge patch and minor updates for GitHub release versions",
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Require manual approval for major Helm chart updates",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual approval for major Docker image updates",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual approval for major Python package updates",
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual approval for major JavaScript/Node.js package updates",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual approval for major Go module updates",
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual approval for major GitHub Actions updates",
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Require manual approval for major GitHub release version updates",
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "Private ECR images: Renovate has no ECR credentials, and each app's own release workflow opens the update PR here",
      "matchPackageNames": [
        "/^\\d{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com\\//"
      ],
      "enabled": false
    },
    {
      "description": "Use semantic versioning for qBittorrent and constrain versions",
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "versioning": "semver",
      "allowedVersions": "<10"
    },
    {
      "description": "Use semantic versioning for Jellyfin and ignore old CalVer versions",
      "matchPackageNames": [
        "lscr.io/linuxserver/jellyfin"
      ],
      "versioning": "semver",
      "allowedVersions": "<=2000"
    },
    {
      "description": "Custom versioning for OpenCCU image - stable releases only (format: MAJOR.MINOR.PATCH.YYYYMMDD, no commit hash)",
      "matchPackageNames": [
        "ghcr.io/openccu/openccu"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d{8})$"
    }
  ],
  "hostRules": [],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update targetRevision in ArgoCD Application templates",
      "managerFilePatterns": [
        "/apps/.+/templates/.+-application\\.yaml$/"
      ],
      "matchStrings": [
        "chart:\\s+(?<depName>[^\\s\\n]+)[\\s\\S]*?repoURL:\\s+(?<registryUrl>https://[^\\s\\n]+)[\\s\\S]*?targetRevision:\\s+[\"']?(?<currentValue>[^\\s\"'{][^\\s\"']*)[\"']?"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update pytr version from PyPI",
      "managerFilePatterns": [
        "/(^|/)apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "pytrVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "pytr",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update pip pins (name==version) listed in app values",
      "managerFilePatterns": [
        "/(^|/)apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "-\\s+[\"']?(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[0-9][^\"'\\s]*)[\"']?"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update versions annotated with '# renovate: datasource=... depName=...' on the line above",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)apps/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*(?:ARG\\s+|ENV\\s+|export\\s+)?[A-Za-z0-9_.-]+\\s*[:=]\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update git commits annotated with '# renovate: datasource=git-refs depName=<repo url> branch=<branch>'",
      "managerFilePatterns": [
        "/(^|/)apps/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>git-refs)\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\s*\\n[^\\n]*\\n\\s*value:\\s*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update Docker image references in YAML files",
      "managerFilePatterns": [
        "/(^|/)apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*['\"]?(?<depName>[^:'\"\\s@]+):(?<currentValue>[^'\"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?['\"]?",
        "#\\s*renovate:\\s*depName=(?<depName>[^\\s]+)\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Helm chart image repository/tag pattern",
      "managerFilePatterns": [
        "/(^|/)apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*['\"]?(?<depName>[^'\"\\s]+)['\"]?\\s*\\n\\s*tag:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update versions annotated with '# renovate: datasource=... depName=...' above a YAML key in GitHub workflows (shell 'key=value' lines are left to the promtool manager)",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Za-z0-9_.-]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the promtool version pinned by the alert-rules workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/alert-rules\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*version=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/test/**",
    "**/tests/**",
    "doc/**"
  ]
}
